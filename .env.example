# ══════════════════════════════════════════════════════════════════════════════
# OpenHospital Sim – Environment Configuration
# ══════════════════════════════════════════════════════════════════════════════
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# ⚠️  Never commit .env to version control.
# ══════════════════════════════════════════════════════════════════════════════


# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=OpenHospital Sim
APP_VERSION=0.6.0
APP_ENV=development          # development | staging | production
DEBUG=false
API_V1_PREFIX=/api/v1


# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=changeme-replace-with-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=1440   # 24 hours


# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3000


# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=openhospital
POSTGRES_PASSWORD=openhospital
POSTGRES_DB=openhospital_sim


# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=            # Uncomment if your Redis instance requires auth


# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_JSON=true                # true = JSON output (production), false = console


# ── Simulation defaults ───────────────────────────────────────────────────────
SIM_SEED=42
SIM_MAX_PATIENTS=500
SIM_TICK_SECONDS=60.0


# ── Frontend (Next.js) ────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000


# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_PASSWORD=admin       # Change in production
