# ══════════════════════════════════════════════════════════════════════════════
# OpenHospital Sim — .gitignore
# ══════════════════════════════════════════════════════════════════════════════

# ── Secrets & environment ─────────────────────────────────────────────────────
.env
.env.local
.env.*.local
.env.production
.env.staging
*.pem
*.key
secrets/

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.Python
pip-wheel-metadata/

# ── Python virtual environments ───────────────────────────────────────────────
.venv/
venv/
env/
ENV/
.python-version

# ── Test & coverage artefacts ─────────────────────────────────────────────────
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.tox/
.nox/
nosetests.xml
pytest-report.xml

# ── Type checking ────────────────────────────────────────────────────────────
.mypy_cache/
.dmypy.json
dmypy.json
.pytype/
.pyre/

# ── Ruff cache ────────────────────────────────────────────────────────────────
.ruff_cache/

# ── Node / npm ────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
package-lock.json.bak

# ── Next.js ───────────────────────────────────────────────────────────────────
.next/
out/
.next/cache/

# ── Build outputs ─────────────────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ── Docker ────────────────────────────────────────────────────────────────────
# Don't ignore docker-compose.yml — it belongs in the repo
# Ignore override files with local secrets
docker-compose.override.yml
docker-compose.local.yml

# ── Database & data ───────────────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
postgres_data/
redis_data/
prometheus_data/
grafana_data/

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/
*.log.*

# ── OS artefacts ──────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── IDE ───────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/

# ── Kubernetes ────────────────────────────────────────────────────────────────
# Ignore rendered secrets (keep manifests, ignore generated secret values)
k8s/secret-rendered.yaml

# ── Temporary ────────────────────────────────────────────────────────────────
*.tmp
*.bak
*.orig
.cache/
tmp/
temp/
