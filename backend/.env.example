# ── Copy to .env and fill in real values ──────────────────────────────────────
# Never commit .env to version control.

# Application
APP_NAME="OpenHospital Sim"
APP_VERSION="0.1.0"
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Security
SECRET_KEY=changeme-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS  (comma-separated list)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=openhospital
POSTGRES_PASSWORD=openhospital
POSTGRES_DB=openhospital_sim

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Logging
LOG_LEVEL=INFO
LOG_JSON=false

# Simulation engine
SIM_TICK_SECONDS=60.0
SIM_MAX_PATIENTS=500
SIM_SEED=42
